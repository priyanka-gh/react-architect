// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`component generator > creates a component folder with styles and a test 1`] = `
[
  {
    "content": "import styles from "./UserCard.module.css";

export interface UserCardProps {
  className?: string;
}

export function UserCard({ className }: UserCardProps) {
  const classes = [styles.root, className].filter(Boolean).join(" ");
  return <div className={classes}>UserCard</div>;
}
",
    "kind": "create",
    "path": "src/components/UserCard/UserCard.tsx",
  },
  {
    "content": ".root {
  display: block;
}
",
    "kind": "create",
    "path": "src/components/UserCard/UserCard.module.css",
  },
  {
    "content": "import { render, screen } from "@testing-library/react";
import { describe, expect, it } from "vitest";
import { UserCard } from "./UserCard";

describe("UserCard", () => {
  it("renders", () => {
    render(<UserCard />);
    expect(screen.getByText("UserCard")).toBeTruthy();
  });
});
",
    "kind": "create",
    "path": "src/components/UserCard/UserCard.test.tsx",
  },
]
`;

