  {
    "content": "import { act, renderHook } from "@testing-library/react";
import { describe, expect, it } from "vitest";
import { useUserProfile } from "./useUserProfile";

describe("useUserProfile", () => {
  it("updates the value", () => {
    const { result } = renderHook(useUserProfile);
    act(() => result.current.setValue("next"));
    expect(result.current.value).toBe("next");
  });
});
",
    "kind": "create",
    "path": "src/features/user-profile/hooks/useUserProfile.test.ts",
  },
  {
    "content": "import type { UserProfileData } from "../types";

export async function fetchUserProfile() {
  const response = await fetch("/api/user-profile");
  if (!response.ok) {
    throw new Error(\`Request failed with status \${response.status}\`);
  }
  return (await response.json()) as UserProfileData;
}
",
