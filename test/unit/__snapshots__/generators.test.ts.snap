exports[`hook generator > creates the hook and its test side by side 1`] = `
[
  {
    "content": "import { useState } from "react";

export function useCart() {
  const [value, setValue] = useState("");
  return { value, setValue };
}
",
    "kind": "create",
    "path": "src/hooks/useCart.ts",
  },
  {
    "content": "import { act, renderHook } from "@testing-library/react";
import { describe, expect, it } from "vitest";
import { useCart } from "./useCart";

describe("useCart", () => {
  it("updates the value", () => {
    const { result } = renderHook(useCart);
    act(() => result.current.setValue("next"));
    expect(result.current.value).toBe("next");
  });
});
",
    "kind": "create",
    "path": "src/hooks/useCart.test.ts",
  },
]
