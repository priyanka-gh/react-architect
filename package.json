{
  "name": "react-architect",
  "displayName": "React Architect",
  "description": "Scaffold React + Vite projects and generate components, hooks and features that follow your project's conventions.",
  "version": "0.1.0",
  "publisher": "your-publisher-id",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/priyanka-gh/react-architect"
  },
  "bugs": {
    "url": "https://github.com/priyanka-gh/react-architect/issues"
  },
  "homepage": "https://github.com/priyanka-gh/react-architect#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0F766E",
    "theme": "dark"
  },
  "keywords": [
    "react",
    "vite",
    "typescript",
    "scaffold",
    "generator",
    "component",
    "hook",
    "architecture"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "react-architect": "./dist/cli.js"
  },
  "activationEvents": [
    "workspaceContains:**/react-architect.json"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "File generation works in Restricted Mode. Commands that run the project's own tools are disabled until the workspace is trusted."
    }
  },
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": "react-architect.json",
        "url": "./schemas/react-architect.schema.json"
      }
    ],
    "viewsWelcome": [
      {
        "view": "explorer",
        "contents": "Start a new React app with TypeScript, Vite and a feature-based structure.\n[Create React Project](command:reactArchitect.createProject)",
        "when": "workbenchState == empty"
      },
      {
        "view": "reactArchitect.projectMap",
        "contents": "The Project Map shows each feature, what it shares, which features use which, and where the structure rules are broken.\nIt needs a react-architect.json in the project.\n[Set Up Existing Project](command:reactArchitect.setUpProject)\n[Create React Project](command:reactArchitect.createProject)",
        "when": "!reactArchitect.hasProject"
      }
    ],
    "commands": [
      {
        "command": "reactArchitect.createProject",
        "title": "Create React Project",
        "category": "React Architect"
      },
      {
        "command": "reactArchitect.setUpProject",
        "title": "Set Up Existing Project",
        "category": "React Architect"
      },
      {
        "command": "reactArchitect.generateComponent",
        "title": "Generate Component",
        "category": "React Architect"
      },
      {
        "command": "reactArchitect.generateHook",
        "title": "Generate Hook",
        "category": "React Architect"
      },
      {
        "command": "reactArchitect.generateFeature",
        "title": "Generate Feature",
        "category": "React Architect"
      },
      {
        "command": "reactArchitect.generatePage",
        "title": "Generate Page",
        "category": "React Architect"
      },
      {
        "command": "reactArchitect.renameFeature",
        "title": "Rename Feature…",
        "category": "React Architect",
        "icon": "$(edit)"
      },
      {
        "command": "reactArchitect.moveToShared",
        "title": "Move to Shared Components",
        "category": "React Architect"
      },
      {
        "command": "reactArchitect.refreshProjectMap",
        "title": "Refresh Project Map",
        "category": "React Architect",
        "icon": "$(refresh)"
      },
      {
        "command": "reactArchitect.chooseStructure",
        "title": "Choose Structure…",
        "category": "React Architect",
        "icon": "$(layers)"
      },
      {
        "command": "reactArchitect.importStructure",
        "title": "Import Structure…",
        "category": "React Architect"
      },
      {
        "command": "reactArchitect.showStructureReport",
        "title": "Show Structure Report",
        "category": "React Architect",
        "icon": "$(output)"
      }
    ],
    "submenus": [
      {
        "id": "reactArchitect.explorerMenu",
        "label": "React Architect"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "reactArchitect.explorerMenu",
          "when": "explorerResourceIsFolder",
          "group": "navigation@10"
        }
      ],
      "reactArchitect.explorerMenu": [
        {
          "command": "reactArchitect.generateComponent",
          "group": "generate@1"
        },
        {
          "command": "reactArchitect.generateHook",
          "group": "generate@2"
        },
        {
          "command": "reactArchitect.generateFeature",
          "group": "generate@3"
        },
        {
          "command": "reactArchitect.setUpProject",
          "group": "setup@1"
        },
        {
          "command": "reactArchitect.generatePage",
          "group": "generate@4"
        },
        {
          "command": "reactArchitect.renameFeature",
          "group": "refactor@1",
          "when": "resourcePath in reactArchitect.featureFolders"
        },
        {
          "command": "reactArchitect.moveToShared",
          "group": "refactor@2",
          "when": "resourcePath in reactArchitect.featureComponentFolders"
        },
        {
          "command": "reactArchitect.chooseStructure",
          "group": "setup@2"
        },
        {
          "command": "reactArchitect.importStructure",
          "group": "setup@3"
        }
      ],
      "view/title": [
        {
          "command": "reactArchitect.refreshProjectMap",
          "when": "view == reactArchitect.projectMap",
          "group": "navigation"
        },
        {
          "command": "reactArchitect.chooseStructure",
          "when": "view == reactArchitect.projectMap",
          "group": "structure@1"
        },
        {
          "command": "reactArchitect.importStructure",
          "when": "view == reactArchitect.projectMap",
          "group": "structure@2"
        },
        {
          "command": "reactArchitect.showStructureReport",
          "when": "view == reactArchitect.projectMap",
          "group": "structure@3"
        }
      ],
      "view/item/context": [
        {
          "command": "reactArchitect.renameFeature",
          "when": "view == reactArchitect.projectMap && viewItem == feature",
          "group": "inline"
        },
        {
          "command": "reactArchitect.renameFeature",
          "when": "view == reactArchitect.projectMap && viewItem == feature",
          "group": "refactor@1"
        }
      ],
      "commandPalette": [
        {
          "command": "reactArchitect.refreshProjectMap",
          "when": "reactArchitect.hasProject"
        },
        {
          "command": "reactArchitect.showStructureReport",
          "when": "reactArchitect.hasProject"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reactArchitect",
          "title": "React Architect",
          "icon": "images/activity-bar.svg"
        }
      ]
    },
    "views": {
      "reactArchitect": [
        {
          "id": "reactArchitect.projectMap",
          "name": "Project Map",
          "contextualTitle": "React Architect"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run check-types && npm run lint && node esbuild.mjs --production",
    "vscode:prepublish": "npm run package",
    "check-types": "tsc --noEmit && tsc -p test/integration --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "pretest:integration": "node esbuild.mjs && tsc -p test/integration",
    "test:integration": "vscode-test",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "package:vsix": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.7",
    "@types/vscode": "1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "ovsx": "^1.4.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "tree-kill": "^1.2.2",
    "typescript": "^6.0.3"
  }
}
